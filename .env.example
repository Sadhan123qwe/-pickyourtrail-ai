# Copy to .env.local and fill in locally. NEVER commit .env.local.
# Everything is optional: with no values the app runs in deterministic mock mode
# with a local SQLite database and seeded demo data.

# --- OpenAI (server-only; never exposed to the browser) ---
# Create a NEW key in the OpenAI dashboard and paste it here, in .env.local only.
# Never put a key in source code, NEXT_PUBLIC_* variables, chat messages or screenshots.
OPENAI_API_KEY=
# Low-cost model for routine tasks (preference extraction, FAQ answers, copilot). Default: gpt-6-luna.
OPENAI_MODEL=
# Optional higher-quality model, used only for itinerary planning. Defaults to OPENAI_MODEL.
OPENAI_MODEL_ADVANCED=
# Realtime voice model. Default: gpt-realtime-2.1-mini (gpt-realtime-mini is deprecated).
OPENAI_REALTIME_MODEL=
# Transcription of the customer's speech inside the realtime session. Default: gpt-4o-mini-transcribe
# (supports server VAD over WebRTC; OpenAI schedules its shutdown for 2027-02-26).
OPENAI_TRANSCRIPTION_MODEL=
# After setting the key: npm run ai:check   (verifies models, a structured request and a voice session)
# Optional: OpenAI-compatible endpoint (e.g. a gateway). Leave blank for api.openai.com.
OPENAI_BASE_URL=

# --- AI guard rails (defaults shown) ---
# AI_MODE=mock forces deterministic mode even when a key is present.
AI_MODE=
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
# Pricing overrides (USD per 1M tokens) for models not in src/lib/ai/pricing.ts
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=

# --- Data retention (npm run db:retention) ---
RETENTION_GUEST_DAYS=90
RETENTION_USAGE_DAYS=400

# --- Load testing only: multiplies every rate limit (leave unset) ---
RATE_LIMIT_MULTIPLIER=

# --- Persistence ---
# Local SQLite file (created automatically).
DATABASE_PATH=data/pickyourtrail.db
# Set to false to start without the 60 days of seeded demo business records.
SEED_BUSINESS_DATA=true

# --- Supabase (NOT implemented in this build; reserved for the Postgres adapter) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
