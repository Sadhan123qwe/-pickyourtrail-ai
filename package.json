{
  "name": "pickyourtrail-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "db:reset": "tsx --conditions=react-server scripts/db-reset.ts",
    "db:retention": "tsx --conditions=react-server scripts/db-retention.ts",
    "bench": "node scripts/bench.mjs",
    "ai:check": "tsx --conditions=react-server scripts/ai-check.ts",
    "test:live": "vitest run --config vitest.live.config.mts",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:secrets"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "openai": "^7.39.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
